/**
 * 排班表格式化脚本
 * 功能：按机型系列分组重命名航班性质并设置背景色，分组后插入空行
 * 作者：WPS AirScript
 * 创建时间：2026-03-17
 * 版本：1.4 (差异行最后标红)
 */

const API = Application;

// 机型系列定义
const MODEL_SERIES = [
    {
        name: "320",
        prefixes: ["320", "322", "32A", "32B", "32C", "32D", "32E", "32G", "32N", "32V", "3HX", "321", "324", "327", "328", "329", "32J", "32H", "32K", "32L", "32M", "32Q", "32R", "32X", "32Y", "32Z"],
        color: 65535  // 黄色 (RGB: 255, 255, 0 -> BGR: 0, 255, 255 -> 0x00FFFF = 65535)
    },
    {
        name: "330",
        prefixes: ["333", "33C", "33G", "33H", "33W"],
        color:  16508374  // 青色 (RGB: 0, 255, 255 -> BGR: 255, 255, 0 -> 0xFFFF00 = 16776960)
    },
    {
        name: "350",
        prefixes: ["350", "359"],
        color: 12611584  // 蓝色 (RGB: 0, 112, 192 -> BGR: 192, 112, 0 -> 0xC07000 = 12611584)
    }
];

// 空行颜色
const EMPTY_ROW_COLOR = 5287936;  // 绿色 (RGB: 0, 176, 80 -> BGR: 80, 176, 0 -> 0x50B000 = 5287936)

// PEK 灰色背景
const PEK_GRAY_COLOR = 8289918; // 灰色 (RGB: 126, 126, 126 -> BGR: 126, 126, 126 -> 0x7E7E7E = 8289918)

// 差异行红色（不一致整行标红）
const DIFF_RED_COLOR = 0x0000FF; // 红色 (RGB: 255, 0, 0 -> BGR: 0, 0, 255 -> 0x0000FF)

function Main() {
    try {
        console.log("开始格式化排班表...");
        
        // 获取排班表工作表
        let scheduleSheet;
        try {
            scheduleSheet = API.Worksheets.Item("排班表");
        } catch (e) {
            try {
                scheduleSheet = Sheets.Item("排班表");
            } catch (err) {
                throw new Error("找不到工作表'排班表'");
            }
        }
        
        // 读取已用范围
        const usedRange = scheduleSheet.UsedRange;
        if (!usedRange || usedRange.Rows.Count <= 1) {
            throw new Error("排班表没有数据");
        }
        
        // 修正：使用 End 方法确定有效数据范围
        const lastRow = scheduleSheet.Cells(scheduleSheet.Rows.Count, 1).End(-4162).Row; // xlUp
        const lastCol = scheduleSheet.Cells(1, scheduleSheet.Columns.Count).End(-4159).Column; // xlToLeft
        
        const rowCount = lastRow;
        const colCount = lastCol;
        
        console.log(`排班表共有 ${rowCount} 行, ${colCount} 列`);
        
        // 一次性读取整块区域
        const dataRange = scheduleSheet.Range(
            scheduleSheet.Cells(1, 1),
            scheduleSheet.Cells(rowCount, colCount)
        );
        let data = dataRange.Value();
        
        // 确保二维数组
        if (data == null) {
            data = [];
        } else if (!Array.isArray(data)) {
            data = [[data]];
        } else if (data.length > 0 && !Array.isArray(data[0])) {
            data = [data];
        }
        
        console.log(`数据读取: ${data.length} 行, ${data[0].length} 列`);
        
        // 查找列索引
        function findColIndex(header, keywords) {
            for (let i = 0; i < header.length; i++) {
                let val = String(header[i] || "").trim();
                for (let kw of keywords) {
                    if (val.indexOf(kw) >= 0) return i;
                }
            }
            return -1;
        }
        
        // 固定+动态查找
        const colFlightType = findColIndex(data[0], ["航班性质"]);  // 航班性质 C列
        const colModel = findColIndex(data[0], ["机型"]);        // 机型 E列
        const colPlaneNo = findColIndex(data[0], ["飞机号", "机号"]);
        const colFilterNote = findColIndex(data[0], ["_filter_note", "filter"]); // 差异标注列
        
        // 优先找进港时间，如果没有再找出港时间
        let colTime = findColIndex(data[0], ["进港时间"]);
        if (colTime === -1) colTime = findColIndex(data[0], ["出港时间", "时间", "计划"]);
        
        const colSeq = findColIndex(data[0], ["序号"]);
        const colPlaneOwner = findColIndex(data[0], ["飞机所属", "所属"]);
        
        console.log(`列索引: 航班性质=${colFlightType+1}, 机型=${colModel+1}, 飞机号=${colPlaneNo+1}, 差异标注=${colFilterNote+1}, 时间=${colTime+1}, 序号=${colSeq+1}, 飞机所属=${colPlaneOwner+1}`);
        
        // 按航班性质分组
        let groups = {
            "航前": [],
            "短停": [],
            "航后": []
        };
        
        // 从第二行开始（跳过表头）
        for (let r = 1; r < data.length; r++) {
            const row = data[r];
            // 跳过空行
            if (!row || row.length === 0) continue;
            
            let flightTypeVal = row[colFlightType];
            if (!flightTypeVal) continue;
            
            const flightType = String(flightTypeVal).trim();
            if (groups.hasOwnProperty(flightType)) {
                groups[flightType].push(row.slice());
            }
        }
        
        // 统计
        let totalDataRows = 0;
        for (const key in groups) {
            totalDataRows += groups[key].length;
        }
        console.log(`分类完成: 航前=${groups["航前"].length}, 短停=${groups["短停"].length}, 航后=${groups["航后"].length}, 总计=${totalDataRows}`);
        
        // 构建结果
        const result = [data[0].slice()];  // 表头
        let processedRows = 0;
        
        ["航前", "短停", "航后"].forEach(function(groupName) {
            let rows = groups[groupName];
            
            // 预处理：判断机型系列并修改航班性质名称
            for (let i = 0; i < rows.length; i++) {
                const row = rows[i];
                const model = String(row[colModel] || "").trim();
                let series = null;
                for (let j = 0; j < MODEL_SERIES.length; j++) {
                    const s = MODEL_SERIES[j];
                    for (let k = 0; k < s.prefixes.length; k++) {
                        if (model.startsWith(s.prefixes[k])) {
                            series = s;
                            break;
                        }
                    }
                    if (series) break;
                }
                
                if (series) {
                    let oldType = String(row[colFlightType] || "").trim();
                    if (["航前", "短停", "航后"].indexOf(oldType) >= 0) {
                        row[colFlightType] = `${series.name} ${oldType}`;
                    }
                }
            }
            
            // 在组内排序：按时间排序，320放最后
            rows.sort(function(a, b) {
                const typeA = String(a[colFlightType] || "");
                const typeB = String(b[colFlightType] || "");
                const isA320 = typeA.indexOf("320") >= 0;
                const isB320 = typeB.indexOf("320") >= 0;
                
                if (isA320 && !isB320) return 1;  // A是320，排到后面
                if (!isA320 && isB320) return -1; // B是320，排到后面
                
                // 如果同为320，或者同为非320(330/350)，则按时间排序
                if (colTime >= 0) {
                    // 提取时间字符串中的数字部分进行比较
                    let timeA = String(a[colTime] || "").replace(/\D/g, "");
                    let timeB = String(b[colTime] || "").replace(/\D/g, "");
                    
                    // 如果进港时间为空，尝试使用出港时间
                    if (!timeA && colTime + 2 < a.length) timeA = String(a[colTime + 2] || "").replace(/\D/g, "");
                    if (!timeB && colTime + 2 < b.length) timeB = String(b[colTime + 2] || "").replace(/\D/g, "");
                    
                    const numA = timeA ? parseInt(timeA, 10) : 99999999;
                    const numB = timeB ? parseInt(timeB, 10) : 99999999;
                    
                    return numA - numB;
                }
                return 0;
            });
            
            // 将排序后的行加入结果
            for (let i = 0; i < rows.length; i++) {
                result.push(rows[i]);
                processedRows++;
            }
            
            // 添加空行
            if (rows.length > 0) {
                const emptyRow = new Array(data[0].length).fill(null);
                result.push(emptyRow);
            }
        });
        
        // --- 匹配发动机型号 ---
        if (colPlaneNo >= 0) {
            try {
                console.log("开始匹配发动机型号...");
                let engineSheet;
                try { engineSheet = API.Worksheets.Item("320发动机型号"); }
                catch(e) { engineSheet = Sheets.Item("320发动机型号"); }
                
                if (engineSheet) {
                    const eLastRow = engineSheet.Cells(engineSheet.Rows.Count, 1).End(-4162).Row;
                    const eLastCol = engineSheet.Cells(1, engineSheet.Columns.Count).End(-4159).Column;
                    if (eLastRow >= 1) {
                        const eData = engineSheet.Range(engineSheet.Cells(1, 1), engineSheet.Cells(eLastRow, eLastCol)).Value();
                        let engineMap = {};
                        
                        // 确保 eData 是二维数组
                        let eDataArr = eData;
                        if (eDataArr != null && !Array.isArray(eDataArr)) eDataArr = [[eDataArr]];
                        else if (eDataArr != null && eDataArr.length > 0 && !Array.isArray(eDataArr[0])) eDataArr = [eDataArr];
                        
                        if (eDataArr && eDataArr.length > 0) {
                            const eHeader = eDataArr[0];
                            const eColPlane = findColIndex(eHeader, ["机号", "飞机号"]);
                            const eColEngine = findColIndex(eHeader, ["发动机型号", "发动机"]);
                            
                            if (eColPlane >= 0 && eColEngine >= 0) {
                                for (let i = 1; i < eDataArr.length; i++) {
                                    let pNo = String(eDataArr[i][eColPlane] || "").trim();
                                    let eMod = String(eDataArr[i][eColEngine] || "").trim();
                                    if (pNo && eMod) {
                                        engineMap[pNo] = eMod;
                                    }
                                }
                                console.log(`成功读取发动机映射，共 ${Object.keys(engineMap).length} 条`);
                                
                                // 应用到 result 中
                                for (let r = 1; r < result.length; r++) {
                                    let row = result[r];
                                    if (!row || row.length === 0) continue;
                                    
                                    let pNo = String(row[colPlaneNo] || "").trim();
                                    if (pNo && engineMap[pNo]) {
                                        let oldModel = String(row[colModel] || "").trim();
                                        row[colModel] = oldModel + "\n" + engineMap[pNo];
                                    }
                                }
                            } else {
                                console.log("在发动机表中未找到'机号'或'发动机型号'列");
                            }
                        }
                    }
                }
            } catch (e) {
                console.log("匹配发动机型号失败: " + e.message);
            }
        } else {
            console.log("未在排班表中找到'飞机号'列，跳过发动机匹配");
        }
        // --- 发动机匹配结束 ---
        
        // 确保结果中没有 undefined，并重新生成序号
        let currentSeq = 1;
        for (let r = 0; r < result.length; r++) {
            // 检查是否是空行
            let isEmpty = true;
            for (let c = 0; c < result[r].length; c++) {
                if (result[r][c] === undefined) {
                    result[r][c] = null;
                }
                if (result[r][c] !== null && result[r][c] !== "") {
                    isEmpty = false;
                }
            }
            
            // 如果不是表头且不是空行，且存在序号列，则重新生成序号
            if (r > 0 && !isEmpty && colSeq >= 0) {
                result[r][colSeq] = currentSeq++;
            }
        }
        
        // 清除原有内容
        scheduleSheet.UsedRange.ClearContents();
        
        // 一次性写回数据
        const writeRange = scheduleSheet.Range(
            scheduleSheet.Cells(1, 1),
            scheduleSheet.Cells(result.length, result[0].length)
        );
        writeRange.Value2 = result;
        
        // 设置颜色
        let emptyRowCount = 0;
        let diffRowCount = 0;
        try {
            for (let r = 0; r < result.length; r++) {
                const row = result[r];
                // 检查是否是空行
                let isEmpty = true;
                for (let c = 0; c < row.length; c++) {
                    if (row[c] !== null && row[c] !== undefined && row[c] !== "") {
                        isEmpty = false;
                        break;
                    }
                }
                
                if (isEmpty) {
                    // 空行整行设置绿色
                    const rowObj = scheduleSheet.Rows(r + 1);
                    rowObj.Interior.Color = EMPTY_ROW_COLOR;
                    emptyRowCount++;
                    continue;
                }
                
                // 跳过表头
                if (r === 0) continue;
                
                // 获取机型判断系列（仅用于上色）
                const model = String(row[colModel] || "").trim();
                let series = null;
                for (let i = 0; i < MODEL_SERIES.length; i++) {
                    const s = MODEL_SERIES[i];
                    for (let j = 0; j < s.prefixes.length; j++) {
                        if (model.startsWith(s.prefixes[j])) {
                            series = s;
                            break;
                        }
                    }
                    if (series) break;
                }
                
                // 检查是否为 320 系列且飞机所属为 PEK
                let isPEK320 = false;
                if (series && series.name === "320" && colPlaneOwner >= 0) {
                    const owner = String(row[colPlaneOwner] || "").trim().toUpperCase();
                    if (owner === "PEK") {
                        isPEK320 = true;
                    }
                }
                
                if (isPEK320) {
                    // 满足条件，整行填充灰色
                    const rowObj = scheduleSheet.Rows(r + 1);
                    rowObj.Interior.Color = PEK_GRAY_COLOR;
                } else {
                    // 不满足条件，仅设置航班性质列背景色
                    const cell = scheduleSheet.Cells(r + 1, colFlightType + 1);
                    if (series && series.color !== null) {
                        cell.Interior.Color = series.color;
                    } else if (series && series.color === null) {
                        cell.Interior.ColorIndex = 0;  // 无填充
                    }
                }
            }
            
            // ===== 最后处理差异标红：放在最后，不会被覆盖 =====
            // 如果有差异标注列，差异行整行标红
            if (colFilterNote >= 0) {
                for (let r = 0; r < result.length; r++) {
                    const row = result[r];
                    if (!row || row.length === 0) continue;
                    if (r === 0) continue;
                    
                    const note = String(row[colFilterNote] || "");
                    if (note.includes("差异")) {
                        // 差异行，整行标红
                        const rowObj = scheduleSheet.Rows(r + 1);
                        rowObj.Interior.Color = DIFF_RED_COLOR;
                        diffRowCount++;
                    }
                }
            }
            
        } catch (colorError) {
            console.log("设置颜色时出错，但数据已写回: " + colorError.message);
        }
        
        // 自适应列宽
        scheduleSheet.UsedRange.EntireColumn.AutoFit();
        // 设置机型列自动换行，以显示发动机型号
        if (colModel >= 0) {
            scheduleSheet.Columns(colModel + 1).WrapText = true;
        }
        
        console.log(`\n格式化完成！`);
        console.log(`  总输出行: ${result.length}`);
        console.log(`  数据行: ${processedRows}`);
        console.log(`  空行: ${emptyRowCount}`);
        console.log(`  差异行标红: ${diffRowCount}`);
        console.log(`  空行颜色: #00B050 (绿色)`);
        console.log(`  差异行颜色: #FF0000 (红色)`);
        for (let i = 0; i < MODEL_SERIES.length; i++) {
            const s = MODEL_SERIES[i];
            const colorText = s.color ? `#${s.color.toString(16).padStart(6, '0')}` : "无填充";
            console.log(`  ${s.name}系列: 航班性质列背景 ${colorText}`);
        }
        
        alert(`格式化完成！\n总输出行: ${result.length}\n数据行: ${processedRows}\n空行: ${emptyRowCount}\n差异行标红: ${diffRowCount}`);
        
    } catch (error) {
        console.log("错误: " + error.message);
        console.log(error.stack);
        alert("错误: " + error.message);
    }
}

// 必须调用入口函数
Main();