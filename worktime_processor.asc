/**
 * 工时匹配脚本 (AirScript 版)
 * 功能：从工单表匹配标准工时，统计工段工时，生成匹配与未匹配结果
 * 作者：WPS AirScript
 * 创建时间：2026-03-21
 */

const API = Application;

// ========= 配置：根据 Sheet 名和列名调整 =========
const SHEET_ORDERS = "导出的待匹配工时内容";   // 工单所在工作表
const SHEET_STD    = "工时参考标准文件";       // 标准工时库工作表
const SHEET_MATCH  = "匹配结果";               // 匹配结果表
const SHEET_UNMATCH = "未匹配结果";             // 未匹配结果表
const SHEET_SECTIONS = "工段分布";             // 工段分布表

const FUZZY_PREFIX_LEN = 6;

/**
 * 模型标准化
 */
function normalizeModel(modelRaw) {
    if (modelRaw === null || modelRaw === undefined) return "";
    let s = String(modelRaw).trim().toUpperCase();
    if (["A320", "A321", "A319"].includes(s)) return "A320S";
    return s;
}

/**
 * 依据文件编码标准化
 */
function normalizeReferenceCode(raw) {
    if (raw === null || raw === undefined) return "";
    let text = String(raw).trim().toUpperCase();
    if (!text) return "";
    
    // 替换特殊横杠
    text = text.replace(/[–—]/g, "-");
    // 移除 REV 及其后续内容
    text = text.replace(/\s+REV.*$/i, "");
    // 压缩多余空格
    text = text.replace(/\s+/g, " ");
    
    // 提取字母前缀和后续数字
    let match = text.match(/^([A-Z]+)\s*(.*)$/);
    if (!match) return text.replace(/\W/g, "");
    
    let prefix = match[1];
    let rest = match[2];
    let digits = rest.match(/\d+/g);
    if (!digits) return prefix;
    
    return prefix + digits.join("");
}

/**
 * 查找列索引（基于名称模糊匹配）
 */
function locateColIndex(headers, candidates) {
    const norm = (s) => String(s || "").replace(/[^\w\u4E00-\u9FFF]/g, "").toUpperCase();
    const candNorms = candidates.map(norm);
    
    // 1. 完全匹配
    for (let i = 0; i < headers.length; i++) {
        let h = norm(headers[i]);
        if (candNorms.includes(h)) return i;
    }
    // 2. 包含匹配
    for (let i = 0; i < headers.length; i++) {
        let h = norm(headers[i]);
        for (let c of candNorms) {
            if (h.includes(c) || c.includes(h)) return i;
        }
    }
    return -1;
}

/**
 * 获取工作表数据（带表头处理）
 */
function getSheetData(sheetName) {
    let sheet = API.Sheets.Item(sheetName);
    if (!sheet) return null;
    let range = sheet.UsedRange;
    if (!range || range.Rows.Count < 1) return null;
    
    let values = range.Value2;
    if (!values || !Array.isArray(values)) return null;
    
    // 如果第一行不是表头，尝试寻找包含“机型”或“依据文件”的行
    // 这里简化处理：直接返回 values
    return values;
}

/**
 * 构建工段映射
 */
function buildSectionMapping(data) {
    if (!data || data.length < 2) return {};
    
    let headerRowIdx = -1;
    for (let r = 0; r < Math.min(10, data.length); r++) {
        if (data[r].some(cell => String(cell || "").includes("员工号"))) {
            headerRowIdx = r;
            break;
        }
    }
    
    if (headerRowIdx === -1) return {};
    
    let sectionRowIdx = headerRowIdx - 1;
    let mapping = {};
    if (sectionRowIdx < 0) return {};
    
    let sectionRow = data[sectionRowIdx];
    let headerRow = data[headerRowIdx];
    let currentSection = "未知工段";
    
    for (let c = 0; c < headerRow.length; c++) {
        let secVal = String(sectionRow[c] || "").trim();
        if (secVal && !secVal.includes("Unnamed") && secVal.toLowerCase() !== "nan") {
            currentSection = secVal;
        }
        
        if (String(headerRow[c] || "").includes("员工号")) {
            for (let r = headerRowIdx + 1; r < data.length; r++) {
                let val = data[r][c];
                if (val === null || val === undefined || String(val).trim() === "") continue;
                let uid = String(val).trim().replace(".0", "");
                if (uid) mapping[uid] = currentSection;
            }
        }
    }
    return mapping;
}

/**
 * 计算最长公共前缀
 */
function commonPrefixLen(a, b) {
    let n = Math.min(a.length, b.length);
    let i = 0;
    while (i < n && a[i] === b[i]) i++;
    return i;
}

/**
 * 主函数
 */
function main() {
    console.log("开始处理工时匹配...");
    const startTime = Date.now();

    // 1. 读取数据
    let ordersData = getSheetData(SHEET_ORDERS);
    let stdData = getSheetData(SHEET_STD);
    let sectionsData = getSheetData(SHEET_SECTIONS);
    
    if (!ordersData || !stdData) {
        alert(`无法读取 ${SHEET_ORDERS} 或 ${SHEET_STD}，请检查工作表是否存在。`);
        return;
    }

    let orderHeaders = ordersData[0];
    let stdHeaders = stdData[0];

    // 2. 定位列
    let oModelIdx = locateColIndex(orderHeaders, ["机型", "飞机型号", "机型号", "机型/机号", "飞机机型"]);
    let oRefIdx   = locateColIndex(orderHeaders, ["依据文件", "依据", "文档编号", "AMM编码", "依据文件编码"]);
    let oAcIdx    = locateColIndex(orderHeaders, ["飞机号", "机号", "注册号", "飞机注册号"]);
    let oDescIdx  = locateColIndex(orderHeaders, ["故障描述（中文）", "故障描述", "中文故障描述"]);
    let oStatusIdx = locateColIndex(orderHeaders, ["工卡状态", "状态"]);
    let oEmpIdIdx = locateColIndex(orderHeaders, ["关卡人工号", "人工号", "员工号"]);
    let oEmpNameIdx = locateColIndex(orderHeaders, ["关卡人名称", "关卡人", "名称"]);

    let sModelIdx = locateColIndex(stdHeaders, ["机型", "飞机型号", "机型号", "机型/机号", "飞机机型"]);
    let sRefIdx   = locateColIndex(stdHeaders, ["依据文件", "依据", "文档编号", "AMM编码", "依据文件编码"]);
    let sHourIdx  = locateColIndex(stdHeaders, ["参考标准工时", "标准工时", "工时标准", "参考工时", "工时"]);

    if (oModelIdx === -1 || oRefIdx === -1) {
        alert(`工单表 ${SHEET_ORDERS} 中未找到机型或依据文件列。`);
        return;
    }
    if (sModelIdx === -1 || sRefIdx === -1 || sHourIdx === -1) {
        alert(`标准库表 ${SHEET_STD} 中未找到必需列。`);
        return;
    }

    // 3. 构建标准库索引
    console.log("构建索引...");
    let indexExact = new Map();
    let indexPrefix = new Map();
    
    for (let r = 1; r < stdData.length; r++) {
        let row = stdData[r];
        let model = normalizeModel(row[sModelIdx]);
        let normCode = normalizeReferenceCode(row[sRefIdx]);
        let hours = row[sHourIdx];
        
        if (!model || !normCode) continue;
        
        let key = `${model}|${normCode}`;
        if (!indexExact.has(key)) {
            indexExact.set(key, { model, normCode, hours });
        }
        
        let prefix = normCode.substring(0, FUZZY_PREFIX_LEN);
        let pkey = `${model}|${prefix}`;
        if (!indexPrefix.has(pkey)) indexPrefix.set(pkey, []);
        indexPrefix.get(pkey).push({ model, normCode, hours });
    }

    // 4. 构建工段映射
    let sectionMap = sectionsData ? buildSectionMapping(sectionsData) : {};

    // 5. 匹配
    console.log("开始匹配...");
    let matchRows = [];
    let unmatchRows = [];
    let reasonStats = {};

    for (let r = 1; r < ordersData.length; r++) {
        let row = ordersData[r];
        if (row.every(cell => cell === null || cell === undefined || cell === "")) continue;

        let modelRaw = row[oModelIdx];
        let refRaw = row[oRefIdx];
        let statusRaw = oStatusIdx !== -1 ? String(row[oStatusIdx] || "").trim() : "";
        let empId = oEmpIdIdx !== -1 ? String(row[oEmpIdIdx] || "").trim().replace(".0", "") : "";
        let empName = oEmpNameIdx !== -1 ? row[oEmpNameIdx] : "";
        let acNum = oAcIdx !== -1 ? row[oAcIdx] : "";
        let desc = oDescIdx !== -1 ? row[oDescIdx] : "";

        let section = sectionMap[empId] || "未匹配工段";
        let normCode = normalizeReferenceCode(refRaw);
        let model = normalizeModel(modelRaw);

        // 状态过滤
        if (["已保留", "未完成"].includes(statusRaw)) {
            let reason = `工卡状态为${statusRaw}`;
            unmatchRows.push([reason, ...row, normCode, "未匹配", "黄色"]);
            reasonStats[reason] = (reasonStats[reason] || 0) + 1;
            continue;
        }

        if (!model) {
            let reason = "机型为空，无法匹配";
            unmatchRows.push([reason, ...row, normCode, "未匹配", "红色"]);
            reasonStats[reason] = (reasonStats[reason] || 0) + 1;
            continue;
        }

        // 匹配逻辑
        let key = `${model}|${normCode}`;
        if (indexExact.has(key)) {
            let res = indexExact.get(key);
            matchRows.push([section, modelRaw, acNum, refRaw, desc, empId, empName, normCode, "完全匹配", "匹配成功", res.hours, "完全匹配到标准工时"]);
        } else {
            let prefix = normCode.substring(0, FUZZY_PREFIX_LEN);
            let pkey = `${model}|${prefix}`;
            let candidates = indexPrefix.get(pkey);
            if (candidates && candidates.length > 0) {
                let best = candidates[0];
                let maxLen = -1;
                for (let cand of candidates) {
                    let len = commonPrefixLen(normCode, cand.normCode);
                    if (len > maxLen) {
                        maxLen = len;
                        best = cand;
                    }
                }
                matchRows.push([section, modelRaw, acNum, refRaw, desc, empId, empName, normCode, "近似匹配", "匹配成功", best.hours, `近似匹配，库编码为 ${best.normCode}`]);
            } else {
                let reason = "在标准工时库中未找到对应记录";
                unmatchRows.push([reason, ...row, normCode, "未匹配", "红色"]);
                reasonStats[reason] = (reasonStats[reason] || 0) + 1;
            }
        }
    }

    // 6. 统计汇总
    console.log("汇总工段工时...");
    let sectionTotals = {};
    matchRows.forEach(row => {
        let sec = row[0];
        let hrs = parseFloat(row[10]) || 0;
        sectionTotals[sec] = (sectionTotals[sec] || 0) + hrs;
    });

    // 排序并添加汇总行
    matchRows.sort((a, b) => String(a[0]).localeCompare(String(b[0])));
    let sortedSections = Object.keys(sectionTotals).sort();
    sortedSections.forEach(sec => {
        if (!sec || String(sec).trim() === "") return;
        let summaryRow = new Array(12).fill("");
        summaryRow[0] = `${sec}汇总工时`;
        summaryRow[10] = sectionTotals[sec];
        matchRows.push(summaryRow);
    });

    // 7. 输出
    console.log("写入结果...");
    const writeToSheet = (sheetName, headers, rows) => {
        let sheet = API.Sheets.Item(sheetName);
        if (!sheet) {
            sheet = API.Sheets.Add(null, API.Sheets.Item(API.Sheets.Count), 1, API.xlWorksheet);
            sheet.Name = sheetName;
        }
        sheet.UsedRange.Clear();
        if (rows.length === 0) {
            sheet.Range("A1").Value2 = [["提示", "没有任何记录"]];
            return;
        }
        
        let output = [headers, ...rows];
        // 分块写入避免大数据量卡死
        const CHUNK_SIZE = 500;
        for (let i = 0; i < output.length; i += CHUNK_SIZE) {
            let chunk = output.slice(i, i + CHUNK_SIZE);
            sheet.Range(`A${i + 1}`).Resize(chunk.length, headers.length).Value2 = chunk;
        }
    };

    let matchHeaders = ["所在工段", "机型", "飞机号", "依据文件", "故障描述（中文）", "关卡人工号", "关卡人名称", "标准化依据文件编码", "匹配类型", "匹配状态", "匹配到的标准工时", "匹配说明"];
    let unmatchHeaders = ["未匹配原因", ...orderHeaders, "标准化依据文件编码", "匹配状态", "颜色标记"];

    writeToSheet(SHEET_MATCH, matchHeaders, matchRows);
    
    // 未匹配统计追加到末尾
    if (unmatchRows.length > 0) {
        unmatchRows.push(new Array(unmatchHeaders.length).fill(""));
        unmatchRows.push(["未匹配原因统计", "数量"]);
        for (let r in reasonStats) {
            unmatchRows.push([r, reasonStats[r]]);
        }
    }
    writeToSheet(SHEET_UNMATCH, unmatchHeaders, unmatchRows);

    const elapsed = (Date.now() - startTime) / 1000;
    console.log(`处理完成！耗时 ${elapsed.toFixed(1)} 秒。`);
    alert(`处理完成！\n成功匹配: ${matchRows.filter(r => r[9] === "匹配成功").length} 条\n未匹配: ${unmatchRows.filter(r => r[0] !== "" && r[0] !== "未匹配原因统计").length} 条`);
}

main();
